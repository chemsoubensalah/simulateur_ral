# ColorVision environment variables.
# Phase 1 (upload, masking, recoloring) needs no configuration.
# The variables below are used from later phases and can stay empty until then.

# Public site URL (used for share links and metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Phase 2 – AI wall detection. The model runs in the browser; slow devices fall
# back to /api/sam/embed, which runs the same model on the server (no key needed).
# Set to "off" to disable the server fallback (e.g. to save server CPU).
SAM_SERVER_FALLBACK=on
# Where the server caches the downloaded model (default: OS temp dir).
SAM_CACHE_DIR=

# Phase 5 – Supabase (auth, database, storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Phase 7 – Stripe (test mode)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
