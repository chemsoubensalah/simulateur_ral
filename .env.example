# Colour visualizer environment variables. None are required.

# Shop branding and contact
NEXT_PUBLIC_BRAND_NAME=ALSY PAINTS
# WhatsApp number of the shop, international format, digits only (e.g. 213550123456)
NEXT_PUBLIC_SELLER_WHATSAPP=
# Can sizes sold, in litres
NEXT_PUBLIC_CAN_SIZES=1,2.5,5,10
# Address printed in the QR poster; empty = the address the poster is opened on
NEXT_PUBLIC_SITE_URL=

# Scene understanding (Paint all walls, wall names, hints). "off" disables it.
SCENE_SERVER=on

# Phase 2 – AI wall detection. The model runs in the browser; slow devices fall
# back to /api/sam/embed, which runs the same model on the server (no key needed).
# Set to "off" to disable the server fallback (e.g. to save server CPU).
SAM_SERVER_FALLBACK=on
# Where the server caches the downloaded model (default: OS temp dir).
SAM_CACHE_DIR=

# Phase 5 – Supabase (auth, database, storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Phase 7 – Stripe (test mode)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Precise walls with SAM 3 ("wall" / "ceiling"), the most accurate option.
# Choose ONE provider (leave all empty to use the built-in AI):
#  - fal.ai GPUs (about $0.005 per prompt, 2 prompts per photo): your fal.ai API key
FAL_KEY=
#  - self-hosted on a server with ≥ 6 GB RAM (≈ 20-25 s per photo on 4 CPU cores):
#    folder with vision_encoder_int8.onnx, text_encoder_int8.onnx, decoder_int8.onnx,
#    tokenizer.json, tokenizer_config.json (from huggingface.co/danilobukvic/sam3-text-onnx)
SAM3_ONNX_DIR=
#  - this site on Vercel, the model on your own server: its address and a shared secret
SAM3_REMOTE_URL=
SAM3_REMOTE_TOKEN=
#  - a free Hugging Face Space built from the sam3-space/ folder (called directly
#    from the browser, ~40 s per photo): its address, e.g. https://name-alsy-walls.hf.space
NEXT_PUBLIC_SAM3_URL=
