# ColorVision environment variables.
# Phase 1 (upload, masking, recoloring) needs no configuration.
# The variables below are used from later phases and can stay empty until then.

# Public site URL (used for share links and metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Phase 2 – optional server fallback for Segment Anything (hosted SAM endpoint)
SAM_FALLBACK_URL=
SAM_FALLBACK_TOKEN=

# Phase 5 – Supabase (auth, database, storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Phase 7 – Stripe (test mode)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
