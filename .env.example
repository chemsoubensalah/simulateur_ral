# Colour visualizer environment variables. None are required.

# Shop branding and contact
NEXT_PUBLIC_BRAND_NAME=ALSY PAINTS
# WhatsApp number of the shop, international format, digits only (e.g. 213550123456)
NEXT_PUBLIC_SELLER_WHATSAPP=
# Can sizes sold, in litres
NEXT_PUBLIC_CAN_SIZES=1,2.5,5,10
# Address printed in the QR poster; empty = the address the poster is opened on
NEXT_PUBLIC_SITE_URL=

# Scene understanding (Paint all walls, wall names, hints). "off" disables it.
SCENE_SERVER=on

# Phase 2 – AI wall detection. The model runs in the browser; slow devices fall
# back to /api/sam/embed, which runs the same model on the server (no key needed).
# Set to "off" to disable the server fallback (e.g. to save server CPU).
SAM_SERVER_FALLBACK=on
# Where the server caches the downloaded model (default: OS temp dir).
SAM_CACHE_DIR=

# Phase 5 – Supabase (auth, database, storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Phase 7 – Stripe (test mode)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
